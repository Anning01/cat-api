# scripts/dev.sh can manage a dedicated local PostgreSQL instance on port 15432.
# Replace change-me with a private password. Use your deployment URL in production.
DATABASE_URL=postgres://cat_api:change-me@127.0.0.1:15432/cat_api
DEBUG=false
# Operator-owned drain marker. Use one absolute shared path across release directories.
DEPLOYMENT_DRAIN_FILE=data/deployment-draining
AUTH_PROVIDER=qiling
# Migration: keep qiling while existing users bind phones; switch to phone afterwards.
PHONE_AUTH_ENABLED=false
PHONE_SIGNUP_ENABLED=false
# Generate once with secrets.token_urlsafe(48), back up securely; never rotate without migration.
PHONE_AUTH_SECRET=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
SMS_CODE_PARAMETER=code
SMS_DAILY_LIMIT=200
# Incident accounts only; comma-separated IDs, separate from normal self-service binding.
PHONE_BIND_BLOCKED_USER_IDS=
# Own verified WeChat service account. Keep disabled until credentials/domain are ready.
WECHAT_LOGIN_ENABLED=false
WECHAT_LOGIN_APP_ID=
WECHAT_LOGIN_APP_SECRET=
WECHAT_LOGIN_ORIGIN=https://shortdramas.xiazq.com
CONSOLE_LOCALE=zh
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
# Persistent Fernet key for recoverable API keys. Keep private and back it up.
API_KEY_ENCRYPTION_KEY=
# Configure the issuer for Qiling sign-in. Set AUTH_PROVIDER=password for local password login.
QILING_API_BASE_URL=
QILING_SIGNUP_ENABLED=false
STUDIO_TEMP_BUCKET=
STUDIO_TEMP_REGION=

# Optional public Apifox documentation URL; administrators can also configure it in the console.
API_DOCUMENTATION_URL=
# Public API server recorded in OpenAPI exports, including /v1. Blank uses /v1.
PUBLIC_API_BASE_URL=
