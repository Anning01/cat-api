# scripts/dev.sh can manage a dedicated local PostgreSQL instance on port 15432.
# Replace change-me with a private password. Use your deployment URL in production.
DATABASE_URL=postgres://cat_api:change-me@127.0.0.1:15432/cat_api
DEBUG=false
AUTH_PROVIDER=qiling
CONSOLE_LOCALE=zh
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_PASSWORD=
# Persistent Fernet key for recoverable API keys. Keep private and back it up.
API_KEY_ENCRYPTION_KEY=
# Configure the issuer for Qiling sign-in. Set AUTH_PROVIDER=password for local password login.
QILING_API_BASE_URL=
QILING_SIGNUP_ENABLED=false
STUDIO_TEMP_BUCKET=
STUDIO_TEMP_REGION=

# Optional public Apifox documentation URL; administrators can also configure it in the console.
API_DOCUMENTATION_URL=
# Public API server recorded in OpenAPI exports, including /v1. Blank uses /v1.
PUBLIC_API_BASE_URL=
